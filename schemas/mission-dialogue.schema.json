{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deity-gates.local/schemas/deity-gates-mission-dialogue-record.schema.json",
  "title": "Mythos Gates Mission Dialogue Record",
  "type": "object",
  "required": [
    "id",
    "missionId",
    "factionId",
    "campaignType",
    "status",
    "lines"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MG-F[0-9]{2}-(ELITE-)?DLG-C[0-9]{2}-M[0-9]{2}$"
    },
    "missionId": {
      "type": "string",
      "pattern": "^MG-F[0-9]{2}-(E-)?C[0-9]{2}-M[0-9]{2}$"
    },
    "factionId": {
      "type": "string",
      "pattern": "^MG-FACTION-[0-9]{3}$"
    },
    "campaignType": {
      "type": "string",
      "enum": [
        "Normal",
        "Elite"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "briefing": {
      "type": "string",
      "minLength": 1
    },
    "lines": {
      "type": "object"
    },
    "soloDeityPolicy": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
