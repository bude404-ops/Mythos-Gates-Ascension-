{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One Deity Vs Many Combat",
  "type": "object",
  "required": [
    "id",
    "schema",
    "status",
    "version",
    "primaryRule",
    "forbiddenSystems",
    "combatFantasy",
    "combatLoop",
    "deityKit",
    "enemyGroupDesign",
    "scalingBands",
    "powerProgression",
    "positioningDecisions",
    "bossBattleRules",
    "dungeonCrawlerIntegration",
    "mobileTouchControls",
    "ue5Implementation",
    "mobilePerformanceRules",
    "firstPrototype"
  ],
  "properties": {
    "id": {
      "const": "MG-ONE-DEITY-VS-MANY-COMBAT-V1"
    },
    "schema": {
      "const": "TG_ONE_DEITY_VS_MANY_COMBAT_V1"
    },
    "status": {
      "const": "CORE_COMBAT_RULE"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[a-z0-9-]+$"
    },
    "primaryRule": {
      "const": "ONE_PLAYER_CONTROLLED_DEITY_PER_BATTLE"
    },
    "forbiddenSystems": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "combatFantasy": {
      "type": "string",
      "minLength": 40
    },
    "combatLoop": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string"
      }
    },
    "deityKit": {
      "type": "object",
      "required": [
        "requiredActions",
        "powerExpression",
        "rule"
      ]
    },
    "enemyGroupDesign": {
      "type": "object",
      "required": [
        "roles",
        "pressureTools",
        "antiPattern",
        "exampleComposition"
      ]
    },
    "scalingBands": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "band",
          "target",
          "enemyCountRange",
          "requiredThreats"
        ]
      }
    },
    "powerProgression": {
      "type": "object",
      "required": [
        "sources",
        "visibleGameplayOutcomes",
        "rule"
      ]
    },
    "positioningDecisions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "bossBattleRules": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "dungeonCrawlerIntegration": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "mobileTouchControls": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string"
      }
    },
    "ue5Implementation": {
      "type": "object",
      "required": [
        "battleDefinition",
        "systems",
        "dataDrivenRule"
      ]
    },
    "mobilePerformanceRules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "firstPrototype": {
      "type": "object",
      "required": [
        "sourceMissionId",
        "requiredDemonstration",
        "progressionFeelTest",
        "expansionRule"
      ]
    }
  }
}