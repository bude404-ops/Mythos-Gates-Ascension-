{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deity-gates.local/schemas/deity-gates-telemetry-contract.schema.json",
  "title": "Mythos Gates Telemetry Contract",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "eventFamilies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MG-BATTLEFIELD-TELEMETRY-CONTRACT-[0-9]{3}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "eventFamilies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "canonSources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
