{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deity-gates.local/schemas/deity-gates-external-ai-packet.schema.json",
  "title": "Mythos Gates External AI Packet",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "targetAsset",
    "tacticalLayout"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "absoluteRule": {
      "type": "string",
      "minLength": 1
    },
    "targetAsset": {
      "type": "object"
    },
    "firstBattlefieldSource": {
      "type": "object"
    },
    "tacticalLayout": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
