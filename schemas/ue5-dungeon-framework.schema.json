{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UE5 Dungeon Crawler Framework",
  "type": "object",
  "required": [
    "id",
    "schema",
    "status",
    "version",
    "purpose",
    "primaryEngine",
    "coreLoop",
    "unrealSystems",
    "dataDrivenRules",
    "deityScaleRules",
    "zoneModel",
    "moduleFamilies",
    "assetPipeline",
    "camera",
    "mobileOptimization",
    "aiGenerationStages",
    "firstTemplate",
    "validation"
  ],
  "properties": {
    "id": {
      "const": "MG-UE5-DUNGEON-CRAWLER-FRAMEWORK-V1"
    },
    "schema": {
      "const": "TG_UE5_DUNGEON_CRAWLER_FRAMEWORK_V1"
    },
    "status": {
      "const": "ACTIVE_TARGET_ARCHITECTURE"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[a-z0-9-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 120
    },
    "primaryEngine": {
      "const": "Unreal Engine 5"
    },
    "coreLoop": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "unrealSystems": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string"
      }
    },
    "dataDrivenRules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "deityScaleRules": {
      "type": "object",
      "required": [
        "environmentLanguage",
        "standardCombatActiveDeities",
        "cameraMandate"
      ]
    },
    "zoneModel": {
      "type": "object",
      "required": [
        "hierarchy",
        "zoneExamples"
      ]
    },
    "moduleFamilies": {
      "type": "object",
      "required": [
        "terrain",
        "structures",
        "props",
        "combat"
      ]
    },
    "assetPipeline": {
      "type": "object",
      "required": [
        "root",
        "folders",
        "formats",
        "rules"
      ]
    },
    "camera": {
      "type": "object",
      "required": [
        "exploration",
        "combat",
        "priority"
      ]
    },
    "mobileOptimization": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "aiGenerationStages": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "string"
      }
    },
    "firstTemplate": {
      "type": "string"
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
