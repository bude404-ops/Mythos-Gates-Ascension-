  "importWorkflow": {
    "status": "IMPLEMENTED",
    "queueCommand": "npm run artwork:queue",
    "dropbox": "artwork_import/dropbox/",
    "importCommand": "npm run artwork:import",
    "finishCommand": "npm run artwork:finish",
    "filenameRule": "Include the permanent asset ID in every file name or parent folder, e.g. TITAN_001__solara-sunforge__source-file.png.",
