      "READY",
      "APPLIED",
      "SUPERSEDED"
    ],
    "allowedTypes": [
      "SCHEMA_EXPANSION",
      "CONTENT_BACKFILL",
      "RUNTIME_PROJECTION",
      "ENGINE_EXPORT",
      "VALIDATION_GATE",
      "CANON_FIX",
      "DOC_POLICY"
    ],
