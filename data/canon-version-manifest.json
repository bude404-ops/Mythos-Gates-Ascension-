  "rules": {
    "versionFormat": "MAJOR.MINOR.PATCH-slug",
    "major": "Breaking canonical data shape or engine export contract changes.",
    "minor": "Backward-compatible canonical content, schema, runtime, or adapter additions.",
    "patch": "Fixes that preserve existing canonical shape and semantics.",
    "migrationRequiredWhen": [
      "A schema required field is added, renamed, moved, or removed.",
      "A canonical ID format or cross-reference rule changes.",
      "Runtime or engine adapters require a different data projection.",
      "Generated index semantics change.",
      "Economy, telemetry, mission objective, or reward meaning changes."
    ],
    "migrationNotRequiredWhen": [
      "Documentation copy changes with no data contract change.",
      "Generated output is rebuilt without source changes.",
      "A browser smoke test or CI stability wrapper changes without canonical semantics."
    ],
    "requiredMigrationFields": [
      "id",
      "fromVersion",
      "toVersion",
      "type",
      "status",
      "owner",
      "summary",
      "affectedData",
      "validation"
    ],
    "allowedStatuses": [
      "PLANNED",
      "READY",
      "APPLIED",
      "SUPERSEDED"
    ],
    "allowedTypes": [
      "SCHEMA_EXPANSION",
      "CONTENT_BACKFILL",
      "RUNTIME_PROJECTION",
      "ENGINE_EXPORT",
      "VALIDATION_GATE",
      "CANON_FIX",
      "DOC_POLICY"
    ],
    "immutability": "Applied migrations are append-only. Supersede with a later migration; do not rewrite history except to correct obvious typos before release."
  },
