{
  "id": "TG-ASSET-PIPELINE-001",
  "title": "Mythos Gates Asset Type and Directory Manifest",
  "status": "Active",
  "updated": "2026-08-10",
  "source": "Hybrid Visual Architecture",
  "directories": {
    "spritesDeities": "art/sprites/deitys/",
    "spritesCharacters": "art/sprites/characters/",
    "spritesEnemies": "art/sprites/enemies/",
    "threeDRealms": "art/3d/realms/",
    "threeDCampaign": "art/3d/campaign/",
    "threeDBattlefields": "art/3d/battlefields/",
    "threeDLocations": "art/3d/locations/",
    "threeDGates": "art/3d/gates/",
    "threeDEnvironment": "art/3d/environment/",
    "portraits": "art/portraits/",
    "cinematic": "art/cinematic/"
  },
  "assetTypes": [
    {
      "type": "SPRITE",
      "layer": "2D",
      "definition": "2D battlefield combatant image",
      "allowedContexts": [
        "Battle",
        "Deity Selection miniature",
        "Combat preview"
      ],
      "blockedContexts": [
        "3D terrain mesh",
        "Realm map geometry"
      ]
    },
    {
      "type": "PORTRAIT",
      "layer": "2D",
      "definition": "Profile and dialogue presentation art",
      "allowedContexts": [
        "Deity Profile",
        "NPC Profile",
        "Codex",
        "Dialogue"
      ],
      "blockedContexts": [
        "Tile/grid combatant if no sprite exists unless temporary placeholder is clearly marked"
      ]
    },
    {
      "type": "CINEMATIC",
      "layer": "2D",
      "definition": "Large story/presentation artwork",
      "allowedContexts": [
        "Campaign intro",
        "Boss reveal",
        "Victory/defeat story"
      ],
      "blockedContexts": [
        "Reusable tactical sprite"
      ]
    },
    {
      "type": "ENVIRONMENT",
      "layer": "3D",
      "definition": "Realm/world/tactical environmental model or scene",
      "allowedContexts": [
        "Campaign",
        "Battlefield",
        "Realm Preview"
      ],
      "blockedContexts": [
        "Combatant sprite replacement"
      ]
    },
    {
      "type": "LOCATION",
      "layer": "3D",
      "definition": "Campaign destination or encounter space",
      "allowedContexts": [
        "Campaign node",
        "Location reveal",
        "Quest scene"
      ],
      "blockedContexts": [
        "Character identity art"
      ]
    },
    {
      "type": "GATE",
      "layer": "3D",
      "definition": "Dimensional travel landmark and objective object",
      "allowedContexts": [
        "Realm transition",
        "Campaign objective",
        "Story location"
      ],
      "blockedContexts": [
        "Futuristic craft replacement or sci-fi vehicle"
      ]
    }
  ],
  "approvalRules": [
    "Every art asset must declare one explicit type.",
    "2D sprite assets and 3D environment assets must remain separated by directory.",
    "Screenshots and visual test captures are review records, not production game assets.",
    "If an asset has the wrong type for a context, Visual QA must flag it before approval."
  ]
}
