      "schema": "schemas/mission.schema.json",
      "engineTargets": [
        "Unreal PrimaryDataAsset",
        "Unity ScriptableObject"
      ]
    },
    {
      "name": "AssetImportManifest",
      "source": "manifests/assets/**/manifest.json",
      "schema": "schemas/asset-manifest.schema.json",
      "engineTargets": [
        "Unreal AssetImportData",
        "Unity AssetPostprocessor metadata"
      ]
    }
  ],
  "guardrails": [
